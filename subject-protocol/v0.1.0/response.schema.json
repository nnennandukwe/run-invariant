{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/nnennandukwe/run-invariant/main/subject-protocol/v0.1.0/response.schema.json",
  "title": "RunInvariant subject response 0.1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "request_sha256", "subject", "results"],
  "properties": {
    "schema_version": {
      "const": "run-invariant.subject-response/0.1.0"
    },
    "request_sha256": { "$ref": "#/$defs/digest" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "implementation": { "type": "string", "minLength": 1 }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "decision"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": { "$ref": "#/$defs/decision" }
        }
      }
    }
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "code", "effects"],
      "properties": {
        "outcome": { "enum": ["allow", "ask", "block"] },
        "code": { "type": "string", "minLength": 1 },
        "effects": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    }
  }
}
